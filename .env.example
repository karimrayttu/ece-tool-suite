# Every one of these is optional. The app starts with none of them set; the features that
# need one report it as unconfigured rather than failing.
#
# Nothing here is read from a file. These are environment variables, so set them in your
# shell or in the launcher before starting the backend. This file is a reference list, not a
# config that gets loaded.

# --- AI ---------------------------------------------------------------------
# Enables the assistant drawer and the model-assisted RTL endpoints.
ANTHROPIC_API_KEY=
# Override the default model (claude-sonnet-4-6).
ECE_SUITE_MODEL=

# --- Parts sourcing ---------------------------------------------------------
# Live Nexar search. Without these, the Parts tab uses the offline catalog.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Digi-Key. These can also be entered in the UI on the Connections tab, in which case they
# stay in backend process memory and are never written to disk.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Point at the sandbox instead of production if you are testing.
DIGIKEY_API_BASE=

# --- Auto-connect at startup ------------------------------------------------
# Bind an instrument to a role before the UI opens. Roles: SCOPE, DMM, SA, PSU, AWG, ELOAD.
# A failed auto-connect is logged and leaves that role disconnected.
# ECE_SUITE_SCOPE_RESOURCE=TCPIP0::192.168.0.50::inst0::INSTR
# ECE_SUITE_DMM_RESOURCE=USB0::0x2A8D::0x1234::MY51234567::INSTR

# --- Paths and process ------------------------------------------------------
# Where the audit log and recorded sessions go. Defaults to ~/.ece-suite.
ECE_SUITE_DATA=
# Port for the sidecar. Defaults to 8848, falling back to the next free port.
ECE_SUITE_PORT=
# Directory holding the built renderer, so the backend can serve the UI itself.
# The Electron shell sets this; you only need it to run the browser fallback by hand.
ECE_SUITE_DIST=
# Identity token the Electron shell passes so it never adopts a sidecar it did not start.
# Set by the shell. Do not set it yourself.
ECE_SUITE_NONCE=
# Base URL the MCP server uses to reach a running app. Defaults to http://127.0.0.1:8848.
ECE_SUITE_URL=
# Extra directory to search for the HDL toolchain binaries (yosys, iverilog, ghdl, ...).
ECE_SUITE_HDL_BIN=
# Where VIBuilder.vi and its guide live for LabVIEW dashboard generation.
# Defaults to ~/.ece-suite/labview.
ECE_SUITE_LABVIEW_DIR=
# Force the packaged resource layout, for smoke-testing a build on the machine that made it.
ECE_SUITE_RESOURCES=
# Override the interpreter the Electron shell spawns.
ECE_SUITE_PYTHON=
